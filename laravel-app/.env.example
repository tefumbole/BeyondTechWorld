APP_NAME="Beyond Enterprise"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION="BCL V.2.1.4"

# Beyond portal: skip WhatsApp OTP at login (LOCAL ONLY — keep false in production)
BEYOND_SKIP_OTP=false

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Messaging channels (Settings → Messaging Settings)
MESSAGING_WHATSAPP_ENABLED=true
MESSAGING_SMS_ENABLED=true

# WhatsApp provider: WASENDER | TWILIO
# WASENDER = all WhatsApp texts/OTP/announcements/documents (default).
# TWILIO WhatsApp Content Templates are optional; Twilio Account SID/Token/Number are still used for SMS.
WHATSAPP_SERVICE=WASENDER
WHATSAPP_DEFAULT_COUNTRY_CODE=237
WHATSAPP_TWILIO_FALLBACK_WASENDER=true
COMPANY_NAME=Beyond Enterprise

# WasenderAPI (WhatsApp)
WASENDER_API_KEY=5a5476030bf03c55f572979dba25ec78260cc40fa8c7390640698c114819a5bd
WASENDER_SESSION_ID=85905
WASENDER_BASE_URL=https://wasenderapi.com/api
WASENDER_MIN_SEND_INTERVAL_MS=6000
WASENDER_TEXT_TO_DOCUMENT_DELAY_MS=6000
WASENDER_WEBHOOK_SECRET=10251db7cc9bdef7e355846673524199
WHATSAPP_WEBHOOK_RETENTION_DAYS=30
WHATSAPP_DEFAULT_CONVERSATION_MODE=HUMAN
WHATSAPP_SESSION_STATUS_CACHE_SECONDS=45
# For WhatsApp Hub webhooks, use the database queue and a worker:
# QUEUE_CONNECTION=database

# Beyond Assistant (Phase 3) — never commit a real AI_API_KEY
WHATSAPP_ASSISTANT_ENABLED=false
WHATSAPP_ASSISTANT_IDENTIFY=true
WHATSAPP_ASSISTANT_NAME="Beyond Assistant"
AI_PROVIDER=openai
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=20
AI_MAX_OUTPUT_TOKENS=400
AI_TEMPERATURE=0.2
AI_MAX_TOOL_ITERATIONS=3
AI_CONFIDENCE_HIGH=0.75
AI_CONFIDENCE_LOW=0.40
AI_MAX_REPLIES_PER_CONTACT_HOUR=20
AI_MEMORY_TTL_HOURS=12
# Phase 4: draft quotations above this amount are not auto-sent on WhatsApp
WHATSAPP_RENTAL_AUTO_QUOTE_MAX=500000

# Optional Twilio WhatsApp Content Templates (only when WHATSAPP_SERVICE=TWILIO)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID_ADMISSION=HX47150e179fdbab79738d060fb0ac6415
TWILIO_WHATSAPP_CONTENT_SID_STATUS=HX47150e179fdbab79738d060fb0ac6415
TWILIO_WHATSAPP_CONTENT_SID_OTP=

# SMS gateway: twilio | clickatell (independent of WhatsApp provider)
SMS_GATEWAY=twilio
ACCOUNT_SID=
AUTH_TOKEN=
TWILIO_NUMBER=
CLICKATELL_API_KEY=

# Legacy aliases still supported by config/services.php:
# WASENDER_API_URL=https://wasenderapi.com/api
# WHATSAPP_SEND_INTERVAL=6
# Twilio_Number=  (legacy; prefer TWILIO_NUMBER)

ULTRAMSG_INSTANCE=
ULTRAMSG_TOKEN=

# Pa Ngwayu funeral pledge page (/pangwayu) — set false to take the module down
FUNERAL_PLEDGE_ENABLED=true
FUNERAL_PLEDGE_ADMIN_PHONE=237677318405
FUNERAL_PLEDGE_CC_PHONES=237677124575

# Stripe (VISA on funeral pledges) — never commit live secrets
STRIPE_KEY=
STRIPE_SECRET=

# Campay (Cameroon MTN/Orange — holder_info uses CAMPAY_TOKEN / MOMO_TOKEN)
CAMPAY_TOKEN=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_APP_ID=
CAMPAY_WEBHOOK_SECRET=
CAMPAY_BASE_URL=https://www.campay.net/api
MOMO_TOKEN=
PAWAPAY_API_TOKEN=
PAWAPAY_TOKEN=
PAWAPAY_USERNAME=
PAWAPAY_PASSWORD=
PAWAPAY_WEBHOOK_SECRET=
PAWAPAY_ENVIRONMENT=production
PAWAPAY_LIVE_BASE_URL=https://api.pawapay.io
# Temporary Mulema callbacks — replace with beyondtechworld.com when ready
PAWAPAY_CHECKOUT_CALLBACK_URL=https://mulemagc.com/api/payments/pawapay/checkouts/callback
PAWAPAY_DEPOSIT_CALLBACK_URL=https://mulemagc.com/api/payments/pawapay/deposits/callback
PAWAPAY_PAYOUT_CALLBACK_URL=https://mulemagc.com/api/payments/pawapay/payouts/callback
PAWAPAY_REFUND_CALLBACK_URL=https://mulemagc.com/api/payments/pawapay/refunds/callback

# Digital Invitations data store (Node/React invitations DB)
BEYOND_DATA_DB_HOST=
BEYOND_DATA_DB_PORT=3306
BEYOND_DATA_DB_DATABASE=
BEYOND_DATA_DB_USERNAME=
BEYOND_DATA_DB_PASSWORD=

# Google Calendar (Stage 9). Leave blank to keep appointments in the ERP only.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CHANNEL_TOKEN=
APPOINTMENT_REMINDERS=false
